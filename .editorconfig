# Cross-editor baseline, so contributors not using VS Code (or not running
# Prettier) still produce consistent whitespace.
# Prettier also reads this file.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = tab
tab_width = 2
max_line_length = 120
insert_final_newline = true
trim_trailing_whitespace = true

# Tabs are a syntax error in YAML, so these must stay space-indented no matter what
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# 2x trailing spaces = hard line break in .md files
# Tab indented list nesting fails to parse in .md
[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

# Generated; never hand-edited.
[pnpm-lock.yaml]
insert_final_newline = false
trim_trailing_whitespace = false
